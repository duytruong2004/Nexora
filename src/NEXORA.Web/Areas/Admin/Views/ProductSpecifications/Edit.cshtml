@model NEXORA.Web.Areas.Admin.Models.ProductSpecificationEditorViewModel
@{
    ViewData["Title"] = "Thông số kỹ thuật sản phẩm";
}
<div class="mb-4"><a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="text-decoration-none">← Sản phẩm</a><p class="text-uppercase small fw-semibold text-primary mt-3 mb-1">Thông số động · @Model.CategoryName</p><h1 class="h2">@Model.ProductName</h1></div>
<form asp-action="Edit" asp-route-id="@Model.ProductId" method="post" class="card border-0 shadow-sm p-4"><input asp-for="ProductId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    @if (Model.Values.Count == 0) { <div class="alert alert-info">Danh mục này chưa được gán thông số kỹ thuật. Hãy gán thông số tại trang quản trị danh mục.</div> }
    @for (var index = 0; index < Model.Values.Count; index++)
    {
        var item = Model.Values[index];
        <input asp-for="Values[index].SpecificationId" type="hidden" />
        <div class="row g-3 align-items-start border-bottom py-3"><div class="col-md-3"><label asp-for="Values[index].Value" class="form-label fw-semibold">@item.Name @if (item.IsRequired) { <span class="text-danger">*</span> }</label><div class="small text-secondary">@item.DataType@(item.Unit is null ? "" : $" · {item.Unit}")</div></div><div class="col-md-5">
            @if (item.DataType == "BOOLEAN")
            {
                <select asp-for="Values[index].Value" class="form-select"><option value="">Chọn giá trị</option><option value="true">Có</option><option value="false">Không</option></select>
            }
            else if (item.DataType == "NUMBER")
            {
                <input asp-for="Values[index].Value" class="form-control" type="number" step="any" placeholder="Nhập số dùng dấu chấm" />
            }
            else if (item.DataType == "ENUM")
            {
                <input asp-for="Values[index].Value" class="form-control" list="enum-options-@item.SpecificationId" autocomplete="off" /><datalist id="enum-options-@item.SpecificationId">@foreach (var option in item.EnumOptions) { <option value="@option"></option> }</datalist>
            }
            else
            {
                <input asp-for="Values[index].Value" class="form-control" />
            }
            <span asp-validation-for="Values[index].Value" class="text-danger"></span>
        </div><div class="col-md-4"><label asp-for="Values[index].DisplayValue" class="form-label">Giá trị hiển thị</label><input asp-for="Values[index].DisplayValue" class="form-control" placeholder="Mặc định lấy từ giá trị lưu trữ" /><span asp-validation-for="Values[index].DisplayValue" class="text-danger"></span></div></div>
    }
    <div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit" disabled="@(Model.Values.Count == 0)">Lưu thông số</button><a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Hủy</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
