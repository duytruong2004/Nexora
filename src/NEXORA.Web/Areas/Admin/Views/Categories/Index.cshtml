@model NEXORA.Web.Areas.Admin.Models.CategoryListViewModel
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <p class="text-uppercase small fw-semibold text-primary mb-1">Quản trị danh mục</p>
        <h1 class="h2 mb-1">Danh mục sản phẩm</h1>
        <p class="small text-secondary mb-0">@Model.Items.Count danh mục đang hiển thị</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm danh mục</a>
</div>

<form method="get" asp-action="Index" class="card card-body border-0 shadow-sm mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-8">
            <label for="search" class="form-label">Tìm theo tên</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Nhập tên danh mục" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-outline-primary flex-grow-1" type="submit">Tìm kiếm</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table admin-data-table align-middle table-hover mb-0">
            <thead class="table-light"><tr><th>Tên</th><th>Danh mục cha</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-secondary py-5">Chưa có danh mục phù hợp.</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="fw-semibold">@item.Name</td>
                    <td>@(item.ParentName ?? "Nhóm gốc")</td>
                    <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Đang dùng" : "Đã ngừng")</span></td>
                    <td class="text-end text-nowrap"><div class="admin-table-actions">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Specifications" asp-action="ConfigureCategory" asp-route-categoryId="@item.Id">Thông số kỹ thuật</a>
                        <form method="post" asp-action="Remove" asp-route-id="@item.Id" onsubmit="return confirm('Xóa danh mục nếu chưa có dữ liệu liên quan, nếu không sẽ ngừng sử dụng?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Xóa / ngừng</button>
                        </form>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
