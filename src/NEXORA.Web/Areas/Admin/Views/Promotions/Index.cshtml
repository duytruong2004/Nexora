@model NEXORA.Web.Areas.Admin.Models.PromotionListViewModel
@{
    ViewData["Title"] = "Quản lý khuyến mại";
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div><p class="text-uppercase small fw-semibold text-primary mb-1">Quản trị bán hàng</p><h1 class="h2 mb-1">Khuyến mại</h1><p class="small text-secondary mb-0">Khuyến mại tốt nhất hợp lệ được áp dụng trên từng dòng sản phẩm, không cộng dồn.</p></div>
    <a class="btn btn-primary" asp-action="Create">Tạo chương trình</a>
</div>
<div class="card border-0 shadow-sm overflow-hidden"><div class="table-responsive"><table class="table admin-data-table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Chương trình</th><th>Mức giảm</th><th>Hiệu lực</th><th>Sản phẩm áp dụng</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
    <tbody>
    @if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-5">Chưa có chương trình khuyến mại.</td></tr> }
    @foreach (var item in Model.Items)
    {
        <tr>
            <td><div class="fw-semibold">@item.Name</div><div class="small text-secondary">#@item.Id</div></td>
            <td class="text-nowrap">@(item.DiscountType == "PERCENTAGE" ? $"{item.DiscountValue:N2}%" : $"{item.DiscountValue:N0} ₫ / dòng")</td>
            <td class="text-nowrap"><div>@DateTime.SpecifyKind(item.StartDate, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div><div class="small text-secondary">đến @DateTime.SpecifyKind(item.EndDate, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></td>
            <td><div>@item.ProductCount sản phẩm</div><div class="small text-secondary text-truncate" style="max-width: 18rem">@string.Join(", ", item.ProductNames)</div></td>
            <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Đang bật" : "Đang tắt")</span></td>
            <td class="text-end text-nowrap"><div class="admin-table-actions"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a><form asp-area="Admin" asp-controller="Promotions" asp-action="@(item.IsActive ? "Disable" : "Enable")" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm @(item.IsActive ? "btn-outline-secondary" : "btn-outline-success")" type="submit">@(item.IsActive ? "Tắt" : "Bật")</button></form></div></td>
        </tr>
    }
    </tbody>
</table></div></div>
