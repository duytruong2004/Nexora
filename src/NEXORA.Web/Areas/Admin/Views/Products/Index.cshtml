@model NEXORA.Web.Areas.Admin.Models.ProductListViewModel
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><p class="text-uppercase small fw-semibold text-primary mb-1">Quản trị danh mục</p><h1 class="h2 mb-0">Sản phẩm</h1></div>
    <a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a>
</div>

<form method="get" asp-action="Index" class="card card-body border-0 shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4"><label for="search" class="form-label">Tên hoặc mã sản phẩm</label><input id="search" name="search" value="@Model.Filter.Search" class="form-control" /></div>
        <div class="col-md-4 col-lg-3"><label for="categoryId" class="form-label">Danh mục</label><select id="categoryId" name="categoryId" class="form-select"><option value="">Tất cả</option>@foreach (var option in Model.CategoryOptions) { <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option> }</select></div>
        <div class="col-md-4 col-lg-3"><label for="brandId" class="form-label">Thương hiệu</label><select id="brandId" name="brandId" class="form-select"><option value="">Tất cả</option>@foreach (var option in Model.BrandOptions) { <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option> }</select></div>
        <div class="col-md-4 col-lg-2"><label for="status" class="form-label">Trạng thái</label><select id="status" name="status" class="form-select"><option value="">Tất cả</option><option value="ACTIVE" selected="@(Model.Filter.Status == "ACTIVE")">Đang kinh doanh</option><option value="INACTIVE" selected="@(Model.Filter.Status == "INACTIVE")">Đã ngừng</option></select></div>
        <div class="col-12 d-flex gap-2"><button class="btn btn-outline-primary" type="submit">Lọc sản phẩm</button><a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a></div>
    </div>
</form>

<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Sản phẩm</th><th>Danh mục</th><th>Thương hiệu</th><th class="text-end">Giá</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
        @if (Model.Page.Items.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-5">Chưa có sản phẩm phù hợp.</td></tr> }
        @foreach (var product in Model.Page.Items)
        {
            <tr>
                <td><div class="d-flex align-items-center gap-3"><div class="product-admin-thumb">@if (product.PrimaryImageUrl is not null) { <img src="@product.PrimaryImageUrl" alt="Ảnh @product.Name" /> } else { <span>Ảnh</span> }</div><div><a asp-action="Details" asp-route-id="@product.Id" class="fw-semibold text-decoration-none">@product.Name</a><div class="small text-secondary">Mã: @product.Sku</div></div></div></td>
                <td>@product.CategoryName</td><td>@product.BrandName</td>
                <td class="text-end text-nowrap">@((product.DiscountPrice ?? product.Price).ToString("N0")) ₫</td>
                <td><span class="badge @(product.Status == "ACTIVE" ? "text-bg-success" : "text-bg-secondary")">@(product.Status == "ACTIVE" ? "Đang bán" : "Đã ngừng")</span></td>
                <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id">Sửa</a>@if (product.Status == "ACTIVE") { <form asp-action="Deactivate" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('Ngừng kinh doanh sản phẩm này? Dữ liệu liên quan sẽ được giữ nguyên.');"><button type="submit" class="btn btn-sm btn-outline-danger">Ngừng</button></form> }</td>
            </tr>
        }
        </tbody>
    </table>
</div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 p-3 border-top"><span class="small text-secondary">@Model.Page.TotalCount sản phẩm · Trang @Model.Page.Page / @Model.Page.PageCount</span><nav aria-label="Phân trang sản phẩm"><ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Model.Page.Page <= 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-search="@Model.Filter.Search" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-brandId="@Model.Filter.BrandId" asp-route-status="@Model.Filter.Status" asp-route-page="@(Model.Page.Page - 1)">Trước</a></li>
        <li class="page-item @(Model.Page.Page >= Model.Page.PageCount ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-search="@Model.Filter.Search" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-brandId="@Model.Filter.BrandId" asp-route-status="@Model.Filter.Status" asp-route-page="@(Model.Page.Page + 1)">Sau</a></li>
    </ul></nav></div>
</div>
