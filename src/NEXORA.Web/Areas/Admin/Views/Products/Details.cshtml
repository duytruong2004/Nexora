@model NEXORA.Web.Areas.Admin.Models.ProductDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var product = Model.Product;
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><a asp-action="Index" class="text-decoration-none">← Sản phẩm</a><p class="text-uppercase small fw-semibold text-primary mt-3 mb-1">@product.CategoryName · @product.BrandName</p><h1 class="h2 mb-1">@product.Name</h1><span class="text-secondary">Mã: @product.Sku</span></div><div class="d-flex gap-2"><a asp-controller="ProductSpecifications" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-primary">Thông số kỹ thuật</a><a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-primary">Chỉnh sửa</a>@if (product.Status == "ACTIVE") { <form asp-action="Deactivate" asp-route-id="@product.Id" method="post" onsubmit="return confirm('Ngừng kinh doanh sản phẩm này?');"><button class="btn btn-outline-danger" type="submit">Ngừng kinh doanh</button></form> }</div></div>
<div class="row g-4">
    <div class="col-lg-5"><div class="card border-0 shadow-sm p-3"><div class="row g-2">
        @if (product.Images.Count == 0) { <div class="col-12"><div class="product-detail-placeholder">Chưa có hình ảnh</div></div> }
        @foreach (var image in product.Images) { <div class="col-6"><figure class="product-image-admin m-0"><img src="@image.ImageUrl" alt="Ảnh sản phẩm @product.Name" /><figcaption class="d-flex justify-content-between align-items-center small mt-2"><span>@(image.IsPrimary ? "Ảnh đại diện" : "Ảnh chi tiết")</span><form asp-action="DeleteImage" method="post"><input type="hidden" name="id" value="@product.Id" /><input type="hidden" name="imageId" value="@image.Id" /><button class="btn btn-sm btn-link text-danger p-0" type="submit">Xóa ảnh</button></form></figcaption></figure></div> }
    </div></div></div>
    <div class="col-lg-7"><div class="card border-0 shadow-sm"><dl class="row p-4 mb-0"><dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8">@(product.Status == "ACTIVE" ? "Đang kinh doanh" : "Đã ngừng")</dd><dt class="col-sm-4">Giá niêm yết</dt><dd class="col-sm-8">@product.Price.ToString("N0") ₫</dd><dt class="col-sm-4">Giá hiện hành</dt><dd class="col-sm-8">@((product.DiscountPrice ?? product.Price).ToString("N0")) ₫</dd><dt class="col-sm-4">Bảo hành</dt><dd class="col-sm-8">@product.WarrantyMonths tháng</dd><dt class="col-sm-4">Đường dẫn</dt><dd class="col-sm-8 text-break">@product.Slug</dd><dt class="col-sm-4">Mô tả</dt><dd class="col-sm-8">@(product.Description ?? "Chưa có mô tả")</dd></dl></div></div>
</div>
<section class="card border-0 shadow-sm mt-4"><div class="card-header bg-white py-3 d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Thông số kỹ thuật</h2><a asp-controller="ProductSpecifications" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Cập nhật thông số</a></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><tbody>
@if (product.Specifications.Count == 0) { <tr><td class="text-center text-secondary py-4">Chưa nhập thông số cho sản phẩm.</td></tr> }
@foreach (var specification in product.Specifications) { <tr><th class="ps-3" style="width:30%">@specification.Name</th><td>@(specification.DisplayValue ?? specification.Value) @if (specification.DataType == "NUMBER" && string.IsNullOrWhiteSpace(specification.DisplayValue) && !string.IsNullOrWhiteSpace(specification.Unit)) { <span>@specification.Unit</span> }</td><td class="text-secondary small">@specification.DataType</td></tr> }
</tbody></table></div></section>
