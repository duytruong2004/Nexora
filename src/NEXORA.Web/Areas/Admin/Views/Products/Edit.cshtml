@model NEXORA.Web.Areas.Admin.Models.ProductFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}
<div class="mb-4"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">← Chi tiết sản phẩm</a><h1 class="h2 mt-2">Chỉnh sửa sản phẩm</h1></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm p-4 catalog-form">
    <input asp-for="Id" type="hidden" />
    <partial name="_ProductForm" model="Model" />
    <div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Lưu thay đổi</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Hủy</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><partial name="_ProductImagePreviewScripts" /> }
