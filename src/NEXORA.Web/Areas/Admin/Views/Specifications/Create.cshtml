@model NEXORA.Web.Areas.Admin.Models.SpecificationFormViewModel
@{
    ViewData["Title"] = "Thêm thông số kỹ thuật";
}
<div class="mb-4"><a asp-action="Index" class="text-decoration-none">← Quản lý thông số kỹ thuật</a><h1 class="h2 mt-2">Thêm thông số kỹ thuật</h1></div>
<form asp-action="Create" method="post" class="card border-0 shadow-sm p-4 catalog-form"><partial name="_SpecificationForm" model="Model" /><div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Lưu thông số</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
