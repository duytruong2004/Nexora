@model NEXORA.Web.Areas.Admin.Models.CategorySpecificationConfigurationViewModel
@{
    ViewData["Title"] = "Thông số kỹ thuật theo danh mục";
}
<div class="mb-4"><a asp-controller="Categories" asp-action="Index" class="text-decoration-none">← Danh mục</a><p class="text-uppercase small fw-semibold text-primary mt-3 mb-1">Cấu hình thuộc tính động</p><h1 class="h2">@Model.CategoryName</h1></div>
<section class="card border-0 shadow-sm mb-4"><div class="card-header bg-white py-3"><h2 class="h5 mb-0">Gán thông số kỹ thuật</h2></div><div class="card-body"><form asp-action="SaveCategorySpecification" method="post" class="row g-3 align-items-end"><input type="hidden" name="categoryId" value="@Model.CategoryId" /><div class="col-lg-5"><label for="specificationId" class="form-label">Thông số kỹ thuật</label><select id="specificationId" name="specificationId" class="form-select" required><option value="">Chọn thông số kỹ thuật</option>@foreach (var item in Model.Available) { <option value="@item.Id">@item.Name · @item.DataType@(item.Unit is null ? "" : $" ({item.Unit})")</option> }</select></div><div class="col-md-4 col-lg-2"><label for="sortOrder" class="form-label">Thứ tự</label><input id="sortOrder" name="sortOrder" type="number" min="0" value="0" class="form-control" /></div><div class="col-md-4 col-lg-2 form-check mt-4"><input id="isFilterable" name="isFilterable" type="checkbox" value="true" class="form-check-input" /><label for="isFilterable" class="form-check-label">Dùng làm bộ lọc</label></div><div class="col-md-4 col-lg-2 form-check mt-4"><input id="isRequired" name="isRequired" type="checkbox" value="true" class="form-check-input" /><label for="isRequired" class="form-check-label">Bắt buộc nhập</label></div><div class="col-lg-1"><button class="btn btn-primary" type="submit" disabled="@(Model.Available.Count == 0)">Gán</button></div></form></div></section>
<section class="card border-0 shadow-sm"><div class="card-header bg-white py-3"><h2 class="h5 mb-0">Thông số kỹ thuật đã gán</h2></div><div class="table-responsive"><table class="table admin-data-table admin-data-table--category-specifications align-middle mb-0"><thead class="table-light"><tr><th>Thông số kỹ thuật</th><th>Kiểu/đơn vị</th><th>Lọc</th><th>Bắt buộc</th><th>Thứ tự</th><th></th></tr></thead><tbody>
@if (Model.Assigned.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-5">Danh mục chưa có thông số. Tạo thông số kỹ thuật trước rồi gán tại đây.</td></tr> }
@foreach (var item in Model.Assigned)
{
    <tr><td class="fw-semibold">@item.Name</td><td><code>@item.DataType</code> · @(item.Unit ?? "không đơn vị")</td><td colspan="4"><div class="d-flex align-items-center gap-3"><form asp-action="SaveCategorySpecification" method="post" class="d-flex align-items-center gap-3 flex-grow-1"><input type="hidden" name="categoryId" value="@Model.CategoryId" /><input type="hidden" name="specificationId" value="@item.SpecificationId" /><label class="form-check"><input class="form-check-input" name="isFilterable" type="checkbox" value="true" checked="@(item.IsFilterable ? "checked" : null)" /><span class="form-check-label">Dùng làm bộ lọc</span></label><label class="form-check"><input class="form-check-input" name="isRequired" type="checkbox" value="true" checked="@(item.IsRequired ? "checked" : null)" /><span class="form-check-label">Bắt buộc</span></label><input class="form-control form-control-sm" name="sortOrder" type="number" min="0" value="@item.SortOrder" style="max-width:100px" /><button class="btn btn-sm btn-outline-primary" type="submit">Lưu</button></form><form asp-action="RemoveCategorySpecification" method="post" onsubmit="return confirm('Gỡ thông số khỏi danh mục?');"><input type="hidden" name="categoryId" value="@Model.CategoryId" /><input type="hidden" name="specificationId" value="@item.SpecificationId" /><button class="btn btn-sm btn-outline-danger" type="submit">Gỡ</button></form></div></td></tr>
}
</tbody></table></div></section>
