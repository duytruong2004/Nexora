@model NEXORA.Web.Areas.Admin.Models.SpecificationFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa Specification";
}
<div class="mb-4"><a asp-action="Index" class="text-decoration-none">← Specification</a><h1 class="h2 mt-2">Chỉnh sửa thông số động</h1></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card border-0 shadow-sm p-4 catalog-form"><input asp-for="Id" type="hidden" /><partial name="_SpecificationForm" model="Model" /><div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Lưu thay đổi</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
