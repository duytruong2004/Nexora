@model NEXORA.Web.Areas.Admin.Models.SpecificationListViewModel
@{
    ViewData["Title"] = "Quản lý Specification";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><p class="text-uppercase small fw-semibold text-primary mb-1">Thông số động</p><h1 class="h2 mb-0">Specification</h1></div><a asp-action="Create" class="btn btn-primary">Thêm thông số</a></div>
<form method="get" asp-action="Index" class="card card-body border-0 shadow-sm mb-4"><div class="row g-2 align-items-end"><div class="col-md-8"><label for="search" class="form-label">Tìm theo tên</label><input id="search" name="search" value="@Model.Search" class="form-control" /></div><div class="col-md-4 d-flex gap-2"><button class="btn btn-outline-primary flex-grow-1" type="submit">Tìm kiếm</button><a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a></div></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Tên</th><th>Kiểu</th><th>Đơn vị</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-center text-secondary py-5">Chưa có thông số phù hợp.</td></tr> }
@foreach (var item in Model.Items)
{
    <tr><td class="fw-semibold">@item.Name</td><td><code>@item.DataType</code></td><td>@(item.Unit ?? "—")</td><td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Đang dùng" : "Đã ngừng")</span></td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>@if (item.IsActive) { <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Ngừng sử dụng Specification này?');"><button class="btn btn-sm btn-outline-danger" type="submit">Ngừng</button></form> }</td></tr>
}
</tbody></table></div></div>
