@model RecommendationRuleAdminPageViewModel
@{
    ViewData["Title"] = "Quy tắc tư vấn";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><p class="text-uppercase small fw-semibold text-primary mb-1">Quản trị tư vấn</p><h1 class="h2 mb-1">Quản lý quy tắc tư vấn</h1><p class="text-secondary mb-0">@Model.Items.Count quy tắc phù hợp</p></div>
    <div class="d-flex gap-2"><a asp-action="UsageNeeds" class="btn btn-outline-primary">Nhu cầu sử dụng</a><a asp-action="CreateRule" class="btn btn-primary">Thêm quy tắc</a></div>
</div>
<form asp-action="Rules" method="get" class="card card-body border-0 shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4"><label for="usageNeedId" class="form-label">Nhu cầu sử dụng</label><select id="usageNeedId" name="usageNeedId" class="form-select"><option value="">Tất cả nhu cầu</option>@foreach (var option in Model.UsageNeedOptions) { <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option> }</select></div>
        <div class="col-md-3"><label for="categoryId" class="form-label">Danh mục</label><select id="categoryId" name="categoryId" class="form-select"><option value="">Tất cả danh mục</option>@foreach (var option in Model.CategoryOptions) { <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option> }</select></div>
        <div class="col-md-3"><label for="isActive" class="form-label">Trạng thái</label><select id="isActive" name="isActive" class="form-select"><option value="">Tất cả</option><option value="true" selected="@(Model.IsActive == true ? "selected" : null)">Đang bật</option><option value="false" selected="@(Model.IsActive == false ? "selected" : null)">Đã tắt</option></select></div>
        <div class="col-md-2 d-flex gap-2"><button class="btn btn-outline-primary" type="submit">Lọc</button><a asp-action="Rules" class="btn btn-outline-secondary" aria-label="Xóa bộ lọc">×</a></div>
    </div>
</form>
<div class="alert alert-info">Trọng số được dùng trong công thức điểm trung bình có trọng số. Rule bắt buộc được áp dụng như điều kiện lọc trước khi xếp hạng. Quy tắc trùng theo nhu cầu, danh mục và thông số kỹ thuật không được bật đồng thời.</div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table admin-data-table admin-data-table--rules align-middle mb-0">
    <thead class="table-light"><tr><th>Nhu cầu</th><th>Danh mục</th><th>Thông số kỹ thuật</th><th>Điều kiện</th><th>Trọng số</th><th>Bắt buộc</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @if (Model.Items.Count == 0) { <tr><td colspan="8" class="text-center text-secondary py-5">Chưa có quy tắc. Hãy tạo hoặc nạp cấu hình demo Development.</td></tr> }
    @foreach (var item in Model.Items)
    {
        <tr><td>@item.UsageNeedName</td><td>@item.CategoryName</td><td><span class="fw-semibold">@item.SpecificationName</span><small class="d-block text-secondary">@item.DataType@(item.Unit is null ? "" : $" · {item.Unit}")</small></td>
            <td><span class="badge text-bg-light border text-dark">@item.Operator</span><code class="ms-1">@item.ThresholdValue</code></td><td class="text-nowrap">@item.Weight.ToString("0.####")</td><td><span class="badge @(item.IsRequired ? "text-bg-warning" : "text-bg-light border text-secondary")">@(item.IsRequired ? "Bắt buộc" : "Ưu tiên")</span></td>
            <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Hoạt động" : "Đã ngừng")</span></td>
            <td class="text-end text-nowrap"><div class="admin-table-actions"><a asp-action="EditRule" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                <form asp-action="ToggleRule" method="post" class="d-inline"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="isActive" value="@(!item.IsActive)" />
                    <button class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(item.IsActive ? "Ngừng" : "Bật")</button>
                </form>
            </div></td>
        </tr>
    }
    </tbody>
</table></div></div>
