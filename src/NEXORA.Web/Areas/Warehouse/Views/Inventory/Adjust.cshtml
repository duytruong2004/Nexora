@model WarehouseStockAdjustmentViewModel
@{
    ViewData["Title"] = "Điều chỉnh tồn kho";
}
<div class="row justify-content-center"><div class="col-12 col-xl-8">
    <div class="mb-4"><div class="text-primary small fw-semibold text-uppercase">Warehouse · Stock Adjustment</div><h1 class="h2 fw-bold">Điều chỉnh tồn kho</h1><p class="text-secondary mb-0">Điều chỉnh chỉ thay đổi tồn vật lý; không thay đổi reservation và không thay thế xuất đơn.</p></div>
    <form asp-action="Adjust" method="post" class="card border-0 shadow-sm"><div class="card-body p-4">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <input asp-for="RequestId" type="hidden" />
        <div class="mb-3"><label asp-for="ProductId" class="form-label">Sản phẩm</label><select asp-for="ProductId" class="form-select"><option value="">Chọn sản phẩm</option>@foreach (var product in Model.Products){<option value="@product.ProductId">@product.Sku · @product.ProductName</option>}</select><span asp-validation-for="ProductId" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Direction" class="form-label">Hướng điều chỉnh</label><select asp-for="Direction" class="form-select"><option value="">Chọn hướng</option><option value="INCREASE">Tăng tồn</option><option value="DECREASE">Giảm tồn</option></select><span asp-validation-for="Direction" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Quantity" class="form-label">Số lượng điều chỉnh</label><input asp-for="Quantity" class="form-control" type="number" min="1" step="1" inputmode="numeric" /><span asp-validation-for="Quantity" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Reason" class="form-label">Lý do bắt buộc</label><input asp-for="Reason" class="form-control" maxlength="250" /><span asp-validation-for="Reason" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="Note" class="form-label">Ghi chú (không bắt buộc)</label><textarea asp-for="Note" class="form-control" rows="3" maxlength="350"></textarea><span asp-validation-for="Note" class="text-danger"></span></div>
        <div class="d-flex flex-wrap gap-2"><button type="submit" class="btn btn-primary">Lưu điều chỉnh</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div>
    </div></form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
