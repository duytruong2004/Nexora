@model WarehouseInventoryIndexViewModel
@{
    ViewData["Title"] = "Quản lý tồn kho";
    var firstItem = Model.Results.TotalCount == 0 ? 0 : ((Model.Results.Page - 1) * Model.Results.PageSize) + 1;
    var lastItem = Math.Min(Model.Results.Page * Model.Results.PageSize, Model.Results.TotalCount);
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || Model.OutOfStockOnly;
}

<div class="warehouse-inventory-page">
    <header class="warehouse-inventory-header">
        <div class="warehouse-inventory-heading">
            <span class="warehouse-inventory-eyebrow">Warehouse · Inventory</span>
            <h1>Quản lý tồn kho</h1>
            <p>Theo dõi tồn vật lý, hàng đang giữ và số lượng có thể bán.</p>
        </div>
        <nav class="warehouse-inventory-toolbar" aria-label="Thao tác tồn kho">
            <a class="warehouse-inventory-toolbar-link" asp-action="History">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 2.64-6.36L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></svg>
                <span>Lịch sử giao dịch</span>
            </a>
            @if (User.IsInRole("Warehouse"))
            {
                <a class="warehouse-inventory-toolbar-link" asp-action="Adjust">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2m4 0h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg>
                    <span>Điều chỉnh tồn</span>
                </a>
                <a class="warehouse-inventory-toolbar-link is-primary" asp-action="Receive">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5"/><path d="M5 16v4h14v-4"/></svg>
                    <span>Nhập kho</span>
                </a>
            }
        </nav>
    </header>

    <section class="warehouse-inventory-search" aria-label="Tìm sản phẩm trong kho">
        <form method="get" asp-action="Index" class="warehouse-inventory-search-form">
            <div class="warehouse-inventory-search-field">
                <label for="inventorySearch">Tìm theo tên sản phẩm hoặc SKU</label>
                <div class="warehouse-inventory-input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
                    <input id="inventorySearch" name="search" type="search" value="@Model.Search" maxlength="100" placeholder="Ví dụ: NXD-LAP-001 hoặc tên sản phẩm" autocomplete="off" />
                </div>
            </div>
            <label class="warehouse-inventory-stock-filter" for="outOfStockOnly">
                <input class="form-check-input" type="checkbox" id="outOfStockOnly" name="outOfStockOnly" value="true" checked="@Model.OutOfStockOnly" />
                <span>Chỉ xem sản phẩm hết hàng</span>
            </label>
            <div class="warehouse-inventory-search-actions">
                @if (hasFilters)
                {
                    <a class="warehouse-inventory-clear" asp-action="Index">Xóa lọc</a>
                }
                <button type="submit" class="warehouse-inventory-search-button">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
                    <span>Tìm kiếm</span>
                </button>
            </div>
        </form>
    </section>

    <section class="warehouse-inventory-results" aria-labelledby="inventoryResultsTitle">
        <div class="warehouse-inventory-results-heading">
            <div>
                <h2 id="inventoryResultsTitle">Danh sách sản phẩm</h2>
                <p>
                    @if (Model.Results.TotalCount > 0)
                    {
                        <span>Đang xem <strong>@firstItem–@lastItem</strong> trong <strong>@Model.Results.TotalCount</strong> sản phẩm</span>
                    }
                    else
                    {
                        <span>Không có sản phẩm phù hợp với bộ lọc hiện tại</span>
                    }
                </p>
            </div>
            <span class="warehouse-inventory-sort-note" title="Sắp xếp theo thời điểm tạo, sản phẩm mới nhất ở trước">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h12M8 12h8M8 18h4"/><path d="m3 8 2-2 2 2M5 6v12m-2-2 2 2 2-2"/></svg>
                Mới tạo trước
            </span>
        </div>

        @if (Model.Results.Items.Count == 0)
        {
            <div class="warehouse-inventory-empty">
                <span class="warehouse-inventory-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
                </span>
                <h3>Chưa tìm thấy sản phẩm</h3>
                <p>Thử từ khóa khác hoặc bỏ bộ lọc “Chỉ xem sản phẩm hết hàng”.</p>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="warehouse-inventory-toolbar-link">Xem toàn bộ sản phẩm</a>
                }
            </div>
        }
        else
        {
            <div class="warehouse-inventory-table-shell">
                <div class="warehouse-inventory-scroll-hint">Vuốt ngang để xem thêm thông tin và thao tác</div>
                <div class="table-responsive warehouse-inventory-table-scroll">
                    <table class="table warehouse-inventory-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="warehouse-inventory-product-column">Sản phẩm</th>
                                <th scope="col">Danh mục</th>
                                <th scope="col" class="text-end">Tồn vật lý</th>
                                <th scope="col" class="text-end">Đang giữ</th>
                                <th scope="col" class="text-end">Có thể bán</th>
                                <th scope="col">Trạng thái</th>
                                <th scope="col" class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Results.Items)
                        {
                            var badge = !row.HasInventory ? "is-missing" : row.AvailableQuantity <= 0 ? "is-empty" : row.AvailableQuantity <= 5 ? "is-low" : "is-available";
                            var status = !row.HasInventory ? "Chưa có tồn" : row.AvailableQuantity <= 0 ? "Hết hàng" : row.AvailableQuantity <= 5 ? "Sắp hết" : "Còn hàng";
                            <tr>
                                <td class="warehouse-inventory-product-column">
                                    <div class="warehouse-inventory-product-name">@row.ProductName</div>
                                    <span class="warehouse-inventory-sku">@row.Sku</span>
                                </td>
                                <td><span class="warehouse-inventory-category">@row.CategoryName</span></td>
                                <td class="text-end"><span class="warehouse-inventory-quantity">@(row.QuantityInStock?.ToString("N0") ?? "—")</span></td>
                                <td class="text-end"><span class="warehouse-inventory-quantity is-muted">@(row.ReservedQuantity?.ToString("N0") ?? "—")</span></td>
                                <td class="text-end"><span class="warehouse-inventory-quantity is-strong">@(row.AvailableQuantity?.ToString("N0") ?? "—")</span></td>
                                <td><span class="warehouse-inventory-status @badge"><span aria-hidden="true"></span>@status</span></td>
                                <td class="text-end">
                                    <div class="warehouse-inventory-row-actions">
                                        <a class="warehouse-inventory-row-action is-history" asp-action="History" asp-route-productId="@row.ProductId" aria-label="Lịch sử tồn kho: @row.ProductName">Lịch sử</a>
                                        @if (User.IsInRole("Warehouse") && row.HasInventory)
                                        {
                                            <a class="warehouse-inventory-row-action" asp-action="Receive" asp-route-productId="@row.ProductId">Nhập kho</a>
                                            <a class="warehouse-inventory-row-action" asp-action="Adjust" asp-route-productId="@row.ProductId">Điều chỉnh</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.Results.PageCount > 1)
            {
                <nav class="warehouse-inventory-pagination" aria-label="Phân trang tồn kho">
                    <span>Trang @Model.Results.Page / @Model.Results.PageCount</span>
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.Results.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-outOfStockOnly="@Model.OutOfStockOnly" asp-route-page="@(Model.Results.Page - 1)" aria-label="Trang trước">‹</a>
                        </li>
                        @for (var pageNumber = 1; pageNumber <= Model.Results.PageCount; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.Results.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-outOfStockOnly="@Model.OutOfStockOnly" asp-route-page="@pageNumber" aria-current="@(pageNumber == Model.Results.Page ? "page" : null)">@pageNumber</a>
                            </li>
                        }
                        <li class="page-item @(Model.Results.Page >= Model.Results.PageCount ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-outOfStockOnly="@Model.OutOfStockOnly" asp-route-page="@(Model.Results.Page + 1)" aria-label="Trang tiếp">›</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </section>
</div>
