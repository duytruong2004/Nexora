@model WarehouseInventoryIndexViewModel
@{
    ViewData["Title"] = "Quản lý tồn kho";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
        <div>
            <div class="text-primary small fw-semibold text-uppercase">Warehouse · Inventory</div>
            <h1 class="h2 fw-bold mb-1">Quản lý tồn kho</h1>
            <p class="text-secondary mb-0">Theo dõi tồn vật lý, hàng đang giữ và số lượng có thể bán.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" asp-action="History">Lịch sử giao dịch</a>
            @if (User.IsInRole("Warehouse"))
            {
                <a class="btn btn-outline-primary" asp-action="Adjust">Điều chỉnh tồn</a>
                <a class="btn btn-primary" asp-action="Receive">Nhập kho</a>
            }
        </div>
    </div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-12 col-lg-7">
                    <label class="form-label" for="inventorySearch">Tên sản phẩm hoặc SKU</label>
                    <input id="inventorySearch" name="search" value="@Model.Search" class="form-control" maxlength="100" placeholder="VD: NXD-LAP-001" />
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="outOfStockOnly" name="outOfStockOnly" value="true" checked="@Model.OutOfStockOnly" />
                        <label class="form-check-label" for="outOfStockOnly">Chỉ sản phẩm hết hàng</label>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-2 d-grid">
                    <button class="btn btn-primary" type="submit">Tìm kiếm</button>
                </div>
            </form>
        </div>
    </section>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h5 mb-0">Danh sách sản phẩm</h2>
        <span class="text-secondary small">@Model.Results.TotalCount sản phẩm</span>
    </div>
    @if (Model.Results.Items.Count == 0)
    {
        <div class="alert alert-light border py-5 text-center">
            <h3 class="h5">Không tìm thấy sản phẩm</h3>
            <p class="text-secondary mb-0">Thử đổi từ khóa hoặc bỏ bộ lọc hết hàng.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>SKU / Sản phẩm</th><th>Danh mục</th><th class="text-end">Tồn vật lý</th><th class="text-end">Đang giữ</th><th class="text-end">Có thể bán</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Results.Items)
                    {
                        var badge = !row.HasInventory ? "text-bg-secondary" : row.AvailableQuantity <= 0 ? "text-bg-danger" : row.AvailableQuantity <= 5 ? "text-bg-warning" : "text-bg-success";
                        var status = !row.HasInventory ? "Chưa tạo tồn kho" : row.AvailableQuantity <= 0 ? "Hết hàng" : row.AvailableQuantity <= 5 ? "Sắp hết" : "Còn hàng";
                        <tr>
                            <td><div class="fw-semibold">@row.ProductName</div><div class="small text-secondary">@row.Sku</div></td>
                            <td>@row.CategoryName</td>
                            <td class="text-end">@(row.QuantityInStock?.ToString("N0") ?? "—")</td>
                            <td class="text-end">@(row.ReservedQuantity?.ToString("N0") ?? "—")</td>
                            <td class="text-end fw-semibold">@(row.AvailableQuantity?.ToString("N0") ?? "—")</td>
                            <td><span class="badge @badge">@status</span></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="History" asp-route-productId="@row.ProductId">Lịch sử</a>
                                @if (User.IsInRole("Warehouse") && row.HasInventory)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Receive" asp-route-productId="@row.ProductId">Nhập</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Adjust" asp-route-productId="@row.ProductId">Điều chỉnh</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.Results.PageCount > 1)
        {
            <nav class="mt-3" aria-label="Phân trang tồn kho">
                <ul class="pagination justify-content-end flex-wrap">
                    @for (var pageNumber = 1; pageNumber <= Model.Results.PageCount; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Results.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-outOfStockOnly="@Model.OutOfStockOnly" asp-route-page="@pageNumber">@pageNumber</a></li>
                    }
                </ul>
            </nav>
        }
    }
</div>
