@model WarehouseQueueViewModel
@{
    ViewData["Title"] = "Hàng đợi kho";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <p class="text-uppercase small fw-semibold text-primary mb-1">Không gian Warehouse</p>
        <h1 class="h2 mb-1">Hàng đợi kho</h1>
        <p class="text-secondary small mb-0">@Model.Results.TotalCount đơn đang chuẩn bị · Chỉ xuất đơn ở trạng thái PREPARING</p>
    </div>
    <div class="rounded-3 bg-white border px-3 py-2 shadow-sm">
        <span class="small text-secondary d-block">Cần xử lý</span>
        <strong class="fs-4">@Model.Results.TotalCount</strong>
    </div>
</div>

<form method="get" asp-area="Warehouse" asp-controller="Orders" asp-action="Index" class="card card-body border-0 shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-9">
            <label class="form-label" for="search">Mã đơn, SKU hoặc tên sản phẩm</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" maxlength="100" placeholder="Ví dụ: 1204 hoặc NXD-LAP-001" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit">Tìm đơn</button>
            <a class="btn btn-outline-secondary" asp-area="Warehouse" asp-controller="Orders" asp-action="Index">Xóa lọc</a>
        </div>
    </div>
</form>

<section class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Mã đơn</th><th>Ngày đặt</th><th class="text-end">Dòng hàng</th><th class="text-end">Tổng số lượng</th><th>Yêu cầu hủy</th><th></th></tr>
            </thead>
            <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-5">Không có đơn nào đang chờ kho xử lý.</td></tr>
            }
            @foreach (var order in Model.Results.Items)
            {
                <tr>
                    <td class="fw-semibold">#@order.OrderId <span class="badge text-bg-info ms-1">Đang chuẩn bị</span></td>
                    <td class="text-nowrap">@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">@order.LineCount</td>
                    <td class="text-end">@order.TotalQuantity</td>
                    <td>
                        @if (order.CancellationRequestStatus is not null)
                        {
                            <span class="badge @CancellationRequestPresentation.BadgeClass(order.CancellationRequestStatus)">@CancellationRequestPresentation.Label(order.CancellationRequestStatus)</span>
                            @if (order.CancellationRequestedAt is not null)
                            {
                                <small class="d-block text-secondary">@order.CancellationRequestedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                            }
                        }
                        else
                        {
                            <span class="text-secondary">Không</span>
                        }
                    </td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-area="Warehouse" asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderId">Xem đơn</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center gap-3 p-3 border-top">
        <span class="small text-secondary">Trang @Model.Results.Page / @Model.Results.PageCount</span>
        <nav aria-label="Phân trang hàng đợi kho">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Results.Page <= 1 ? "disabled" : "")"><a class="page-link" asp-area="Warehouse" asp-controller="Orders" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Results.Page - 1)">Trước</a></li>
                <li class="page-item @(Model.Results.Page >= Model.Results.PageCount ? "disabled" : "")"><a class="page-link" asp-area="Warehouse" asp-controller="Orders" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Results.Page + 1)">Sau</a></li>
            </ul>
        </nav>
    </div>
</section>
