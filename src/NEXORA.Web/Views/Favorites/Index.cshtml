@model IReadOnlyList<NEXORA.Application.Engagement.FavoriteListItem>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}
<section class="mb-4">
    <p class="text-uppercase small fw-semibold text-primary mb-1">Tài khoản của tôi</p>
    <h1 class="h2 fw-bold mb-2">Sản phẩm yêu thích</h1>
    <p class="text-secondary mb-0">Danh sách riêng của tài khoản đang đăng nhập.</p>
</section>
@if (Model.Count == 0)
{
    <div class="catalog-empty rounded-4 p-5 text-center">
        <div class="display-5" aria-hidden="true">♡</div>
        <h2 class="h4 mt-3">Danh sách đang trống</h2>
        <p class="text-secondary">Thêm sản phẩm bạn quan tâm từ Catalog hoặc trang chi tiết.</p>
        <a class="btn btn-primary" asp-controller="Catalog" asp-action="Index">Khám phá sản phẩm</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card h-100 border-0 shadow-sm">
                    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="product-card-image">
                        @await Html.PartialAsync("_ProductImage", new NEXORA.Web.Models.ProductImageDisplayViewModel(item.PrimaryImageUrl, item.ProductName, "card"))
                    </a>
                    <div class="card-body d-flex flex-column">
                        <p class="small text-secondary mb-2">@item.CategoryName · @item.BrandName</p>
                        <h2 class="h5"><a class="text-decoration-none" asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId">@item.ProductName</a></h2>
                        <p class="small text-secondary">Mã: @item.Sku</p>
                        <strong class="text-primary fs-5 mt-auto">@((item.DiscountPrice ?? item.Price).ToString("N0")) ₫</strong>
                        <div class="d-flex gap-2 mt-3">
                            <a class="btn btn-outline-primary flex-fill" asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId">Xem chi tiết</a>
                            <form asp-controller="Favorites" asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button class="btn btn-outline-danger" type="submit" aria-label="Xóa @item.ProductName khỏi yêu thích">Xóa</button>
                            </form>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
