@model IReadOnlyList<NEXORA.Application.Commerce.OrderListItem>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<section class="page-heading mb-4">
    <p class="text-uppercase small fw-semibold text-primary mb-2">NEXORA · Tài khoản</p>
    <h1 class="display-6 fw-bold mb-2">Đơn hàng của tôi</h1>
    <p class="text-secondary mb-0">Theo dõi trạng thái và thông tin của các đơn hàng bạn đã đặt.</p>
</section>

@if (Model.Count == 0)
{
    <section class="catalog-empty rounded-4 p-5 text-center">
        <div class="display-5 mb-3" aria-hidden="true">📦</div>
        <h2 class="h4">Bạn chưa có đơn hàng</h2>
        <p class="text-secondary">Đơn hàng đã đặt sẽ xuất hiện tại đây.</p>
        <a class="btn btn-primary" asp-controller="Catalog" asp-action="Index">Khám phá sản phẩm</a>
    </section>
}
else
{
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Sản phẩm</th><th>Trạng thái</th><th class="text-end">Tổng tiền</th><th></th></tr></thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-semibold">#@order.Id</td>
                        <td>@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.ProductCount</td>
                        <td>
                            <span class="badge rounded-pill @StatusClass(order.Status)">@StatusLabel(order.Status)</span>
                            @if (order.CancelRequestStatus is not null)
                            {
                                <span class="badge rounded-pill @CancellationRequestPresentation.BadgeClass(order.CancelRequestStatus)">@CancellationRequestPresentation.Label(order.CancelRequestStatus)</span>
                            }
                        </td>
                        <td class="text-end fw-semibold text-nowrap">@order.TotalAmount.ToString("N0") ₫</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@order.Id">Xem chi tiết</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@functions {
    private static string StatusClass(string status) => status switch
    {
        "PENDING" => "text-bg-warning",
        "CANCELLED" => "text-bg-secondary",
        "COMPLETED" => "text-bg-success",
        _ => "text-bg-primary"
    };

    private static string StatusLabel(string status) => status switch
    {
        "PENDING" => "Chờ xác nhận",
        "CONFIRMED" => "Đã xác nhận",
        "PREPARING" => "Đang chuẩn bị",
        "EXPORTED" => "Đã xuất kho",
        "SHIPPING" => "Đang giao",
        "COMPLETED" => "Hoàn thành",
        "CANCELLED" => "Đã hủy",
        _ => status
    };
}
