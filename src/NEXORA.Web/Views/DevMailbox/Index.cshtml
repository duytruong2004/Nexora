@model IReadOnlyList<NEXORA.Web.Email.DevelopmentEmail>
@{
    ViewData["Title"] = "Hộp thư Development";
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div>
        <p class="text-uppercase fw-semibold small text-primary mb-2">Chỉ dành cho Development</p>
        <h1 class="h3 fw-bold mb-0">Hộp thư giả lập</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary">Chưa có email trong phiên Development này.</div>
}
else
{
    <div class="list-group">
        @foreach (var item in Model)
        {
            <article class="list-group-item p-4">
                <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                    <h2 class="h5 mb-0">@item.Message.Subject</h2>
                    <time class="text-secondary small">@item.QueuedAt.ToLocalTime().ToString("g")</time>
                </div>
                <p class="text-secondary small mb-3">To: @item.Message.To</p>
                <div class="mail-message">@Html.Raw(item.Message.HtmlBody)</div>
            </article>
        }
    </div>
}
