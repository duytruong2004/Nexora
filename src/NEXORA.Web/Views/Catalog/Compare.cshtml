@model NEXORA.Web.Models.CatalogComparisonViewModel
@{
    ViewData["Title"] = "So sánh sản phẩm";
}
<div class="mb-4"><a asp-controller="Catalog" asp-action="Index" class="text-decoration-none">← Danh sách sản phẩm</a><h1 class="h2 mt-2">So sánh sản phẩm</h1></div>
@if (Model.Error is not null)
{
    <div class="catalog-empty rounded-4 p-4 text-center"><h2 class="h5">Chưa thể so sánh</h2><p class="text-secondary mb-0">@Model.Error</p><a asp-action="Index" class="btn btn-primary mt-3">Quay lại danh sách</a></div>
}
else if (Model.Comparison is { } comparison)
{
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3"><p class="text-secondary mb-0">Đang so sánh @comparison.Products.Count sản phẩm cùng danh mục.</p><label class="form-check mb-0"><input id="onlyDifferent" class="form-check-input" type="checkbox" /><span class="form-check-label">Chỉ hiện thông số khác nhau</span></label></div>
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table comparison-table align-middle mb-0"><thead class="table-light"><tr><th class="comparison-spec-head" scope="col">Thông tin</th>
        @foreach (var product in comparison.Products)
        {
            var primaryImage = product.Images.FirstOrDefault(image => image.IsPrimary) ?? product.Images.OrderBy(image => image.SortOrder).FirstOrDefault();
            <th scope="col"><div class="comparison-product-image">@await Html.PartialAsync("_ProductImage", new NEXORA.Web.Models.ProductImageDisplayViewModel(primaryImage?.ImageUrl, product.Name, "comparison"))</div><a asp-action="Details" asp-route-id="@product.Id" class="comparison-product-name">@product.Name</a><div class="small text-secondary fw-normal mt-1">@product.BrandName</div><strong class="d-block text-primary mt-2">@((product.DiscountPrice ?? product.Price).ToString("N0")) ₫</strong></th>
        }
    </tr></thead><tbody>
        <tr><th scope="row">Danh mục</th>@foreach (var product in comparison.Products) { <td>@product.CategoryName</td> }</tr>
        <tr><th scope="row">Mã sản phẩm</th>@foreach (var product in comparison.Products) { <td>@product.Sku</td> }</tr>
        @foreach (var specification in comparison.Specifications)
        {
            <tr class="@(specification.IsDifferent ? "comparison-different" : "")" data-different="@(specification.IsDifferent ? "true" : "false")"><th scope="row">@specification.Name@(specification.Unit is null ? "" : $" ({specification.Unit})")</th>
                @foreach (var value in specification.Values) { <td>@(value ?? "Chưa có dữ liệu")</td> }
            </tr>
        }
        <tr><th scope="row">Bảo hành</th>@foreach (var product in comparison.Products) { <td>@product.WarrantyMonths tháng</td> }</tr>
    </tbody></table></div></div>
}
@section Scripts { <script src="~/js/catalog-compare-display.js" asp-append-version="true"></script> }
