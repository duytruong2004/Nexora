@model NEXORA.Web.Models.StorefrontHomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    var featured = Model.Data.Products.FirstOrDefault();
}
@section Head {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
}

<section class="storefront-hero storefront-hero--home mb-4 mb-lg-5" aria-labelledby="home-title">
    <div class="storefront-hero-copy">
        @if (featured is not null)
        {
            <p class="storefront-hero-kicker"><span aria-hidden="true"></span> NEXORA ĐỀ XUẤT <b aria-hidden="true">·</b> @featured.CategoryName</p>
            <h1 id="home-title">@featured.Name</h1>
            <p class="storefront-hero-description">@(!string.IsNullOrWhiteSpace(featured.Description) ? featured.Description : "Khám phá sản phẩm phù hợp với nhu cầu của bạn tại NEXORA.")</p>
            <div class="storefront-hero-price">
                <span class="storefront-hero-price-label">@(featured.DiscountPrice.HasValue ? "Giá ưu đãi" : "Giá sản phẩm")</span>
                <strong>@((featured.DiscountPrice ?? featured.Price).ToString("N0")) ₫</strong>
                @if (featured.DiscountPrice.HasValue)
                {
                    <del>@featured.Price.ToString("N0") ₫</del>
                    <span class="storefront-hero-sale-badge">Đang giảm giá</span>
                }
            </div>
            <div class="storefront-hero-actions">
                <a class="btn btn-primary btn-lg" asp-controller="Catalog" asp-action="Details" asp-route-id="@featured.Id">Xem chi tiết <span aria-hidden="true">↗</span></a>
                <a class="btn btn-outline-primary btn-lg" asp-controller="Catalog" asp-action="Index">Khám phá sản phẩm</a>
            </div>
        }
        else
        {
            <p class="storefront-hero-kicker"><span aria-hidden="true"></span> NEXORA · MUA SẮM CÔNG NGHỆ</p>
            <h1 id="home-title">Tìm thiết bị phù hợp với bạn.</h1>
            <p class="storefront-hero-description">Khám phá sản phẩm theo danh mục và tìm lựa chọn phù hợp với nhu cầu của bạn.</p>
            <div class="storefront-hero-actions">
                <a class="btn btn-primary btn-lg" asp-controller="Catalog" asp-action="Index">Khám phá sản phẩm <span aria-hidden="true">↗</span></a>
                <a class="btn btn-outline-primary btn-lg" asp-controller="Consultation" asp-action="Index">Bắt đầu tư vấn</a>
            </div>
        }
        <div class="storefront-hero-assurance"><span aria-hidden="true">✓</span> Thông tin sản phẩm minh bạch</div>
    </div>
    @if (featured is not null)
    {
        <a class="storefront-hero-product" asp-controller="Catalog" asp-action="Details" asp-route-id="@featured.Id" aria-label="Xem chi tiết @featured.Name">
            <span class="storefront-hero-product-tag"><span aria-hidden="true">✦</span> SẢN PHẨM NỔI BẬT</span>
            <span class="storefront-hero-product-brand">@featured.BrandName</span>
            @await Html.PartialAsync("_ProductImage", new NEXORA.Web.Models.ProductImageDisplayViewModel(featured.PrimaryImageUrl, featured.Name, "card"))
            <span class="storefront-hero-product-caption"><span>@featured.CategoryName</span></span>
        </a>
    }
    else
    {
        <div class="storefront-hero-art" aria-hidden="true"><span>N</span><i></i><b></b></div>
    }
</section>

@if (Model.Data.Categories.Count > 0)
{
    <section class="storefront-category-section mb-5" aria-labelledby="categories-title">
        <div class="storefront-section-heading">
            <div><p class="storefront-eyebrow mb-1">Tìm nhanh theo nhu cầu</p><h2 id="categories-title">Danh mục sản phẩm</h2></div>
            <a asp-controller="Catalog" asp-action="Index" class="storefront-section-link">Tất cả sản phẩm <span aria-hidden="true">→</span></a>
        </div>
        <nav class="storefront-category-strip" aria-label="Danh mục sản phẩm">
            <a class="storefront-category-chip storefront-category-chip--all" asp-controller="Catalog" asp-action="Index">Tất cả</a>
            @foreach (var category in Model.Data.Categories)
            {
                <a class="storefront-category-chip" asp-controller="Catalog" asp-action="Category" asp-route-id="@category.Id">@category.Name <span aria-hidden="true">↗</span></a>
            }
        </nav>
    </section>
}

@if (Model.Data.CategorySections.Count > 0)
{
    <section class="mb-5" aria-labelledby="home-category-products-title">
        <div class="storefront-section-heading">
            <div><p class="storefront-eyebrow mb-1">Khám phá theo nhu cầu</p><h2 id="home-category-products-title">Sản phẩm theo danh mục</h2></div>
            <a asp-controller="Catalog" asp-action="Index" class="storefront-section-link">Tất cả sản phẩm <span aria-hidden="true">→</span></a>
        </div>
        @foreach (var categorySection in Model.Data.CategorySections)
        {
            var categoryHeadingId = $"home-category-{categorySection.Category.Id}";
            <section class="storefront-home-category mb-4" aria-labelledby="@categoryHeadingId">
                <div class="storefront-section-heading storefront-home-category-heading">
                    <h3 id="@categoryHeadingId">@categorySection.Category.Name</h3>
                    <a asp-controller="Catalog" asp-action="Category" asp-route-id="@categorySection.Category.Id" class="storefront-section-link">Xem danh mục <span aria-hidden="true">→</span></a>
                </div>
                <div class="storefront-product-grid storefront-home-category-grid">
                    @foreach (var product in categorySection.Products)
                    {
                        <div class="storefront-product-grid-item"><partial name="_ProductCard" model="product" /></div>
                    }
                </div>
            </section>
        }
    </section>
}
else if (Model.Data.Products.Count == 0)
{
    <section class="mb-5" aria-labelledby="featured-title">
        <div class="storefront-section-heading">
            <div><p class="storefront-eyebrow mb-1">Lựa chọn dành cho bạn</p><h2 id="featured-title">Sản phẩm đang kinh doanh</h2></div>
            <a asp-controller="Catalog" asp-action="Index" class="storefront-section-link">Xem tất cả <span aria-hidden="true">→</span></a>
        </div>
        <div class="catalog-empty rounded-4 p-4 text-secondary">Chưa có sản phẩm đang kinh doanh. Quản trị viên có thể thêm sản phẩm từ khu vực Admin.</div>
    </section>
}
else
{
    <section class="mb-5" aria-labelledby="featured-title">
        <div class="storefront-section-heading">
            <div><p class="storefront-eyebrow mb-1">Lựa chọn dành cho bạn</p><h2 id="featured-title">Sản phẩm đang kinh doanh</h2></div>
            <a asp-controller="Catalog" asp-action="Index" class="storefront-section-link">Xem tất cả <span aria-hidden="true">→</span></a>
        </div>
        <div class="storefront-product-grid">
            @foreach (var product in Model.Data.Products)
            {
                <div class="storefront-product-grid-item"><partial name="_ProductCard" model="product" /></div>
            }
        </div>
    </section>
}

<section class="consultation-banner rounded-4 p-4 p-lg-5 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4" aria-labelledby="consultation-title">
    <div><p class="storefront-eyebrow mb-2">Tư vấn thông minh NEXORA</p><h2 id="consultation-title" class="h3 fw-bold">Mô tả nhu cầu bằng tiếng Việt</h2><p class="mb-0 text-secondary">Nêu ngân sách, mục đích và điều bạn ưu tiên. Gợi ý được xếp hạng từ sản phẩm cùng thông số đang có trong hệ thống.</p></div>
    <a class="btn btn-primary btn-lg flex-shrink-0" asp-controller="Consultation" asp-action="Index">Tư vấn ngay <span aria-hidden="true">→</span></a>
</section>
