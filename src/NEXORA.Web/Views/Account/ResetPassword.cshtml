@model NEXORA.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt mật khẩu mới";
}

<div class="card account-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 fw-bold mb-2">Đặt mật khẩu mới</h1>
        <p class="text-secondary mb-4">Tạo mật khẩu mới cho tài khoản của bạn.</p>
        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Cập nhật mật khẩu</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
