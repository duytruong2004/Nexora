@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Kiểm tra email";
}

<div class="card account-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 fw-bold">Kiểm tra email</h1>
        <p class="text-secondary mb-0">Nếu địa chỉ email khớp với tài khoản đang hoạt động, liên kết đặt lại mật khẩu đã được gửi.</p>
        @if (HostEnvironment.IsDevelopment())
        {
            <p class="mt-3 mb-0"><a href="/dev/mailbox">Mở hộp thư Development</a></p>
        }
    </div>
</div>
