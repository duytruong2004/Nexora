@model NEXORA.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Khôi phục mật khẩu";
}

<div class="card account-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 fw-bold mb-2">Khôi phục mật khẩu</h1>
        <p class="text-secondary mb-4">Nếu email thuộc tài khoản đang hoạt động, NEXORA sẽ gửi liên kết đặt lại mật khẩu.</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Gửi liên kết</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
