@model CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<section class="page-heading mb-4">
    <p class="text-uppercase small fw-semibold text-primary mb-2">NEXORA · Đặt hàng</p>
    <h1 class="display-6 fw-bold mb-2">Thông tin giao hàng</h1>
    <p class="text-secondary mb-0">Giá và tồn kho sẽ được xác minh lại trước khi đơn hàng được tạo.</p>
</section>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
@if (Model.Quote.IsEmpty)
{
    <section class="catalog-empty rounded-4 p-5 text-center">
        <h2 class="h4">Giỏ hàng đang trống</h2>
        <p class="text-secondary">Thêm sản phẩm vào giỏ trước khi thanh toán.</p>
        <a class="btn btn-primary" asp-controller="Catalog" asp-action="Index">Khám phá sản phẩm</a>
    </section>
}
else
{
    <div class="row g-4 align-items-start">
        <div class="col-lg-7">
            <form asp-action="Place" method="post" class="card border-0 shadow-sm p-4 checkout-form">
                @Html.AntiForgeryToken()
                <input asp-for="RequestId" type="hidden" />
                <input asp-for="QuoteToken" type="hidden" />
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label"></label>
                    <input asp-for="CustomerName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" inputmode="tel" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ShippingAddress" class="form-label"></label>
                    <textarea asp-for="ShippingAddress" class="form-control" rows="3" autocomplete="street-address"></textarea>
                    <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Note" class="form-label"></label>
                    <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Note" class="text-danger small"></span>
                </div>
                @if (!Model.Quote.CanCheckout)
                {
                    <div class="alert alert-warning" role="status">Có sản phẩm không đủ tồn hoặc đã ngừng kinh doanh. Vui lòng quay lại giỏ hàng.</div>
                }
                <button class="btn btn-primary btn-lg" type="submit" disabled="@(!Model.Quote.CanCheckout)">Xác nhận đặt hàng</button>
            </form>
        </div>
        <div class="col-lg-5">
            <section class="card border-0 shadow-sm p-4 checkout-summary" aria-labelledby="checkout-summary-title">
                <h2 id="checkout-summary-title" class="h5 mb-3">Tóm tắt đơn hàng</h2>
                <div class="checkout-lines">
                    @foreach (var line in Model.Quote.Lines)
                    {
                        <div class="d-flex justify-content-between gap-3 py-3 border-bottom">
                            <div class="min-w-0">
                                <div class="fw-semibold">@line.ProductName</div>
                                <div class="small text-secondary">@line.Quantity × @line.UnitPrice.ToString("N0") ₫</div>
                                @if (line.DiscountAmount > 0)
                                {
                                    <div class="small text-success">@line.PromotionName · giảm @line.DiscountAmount.ToString("N0") ₫</div>
                                }
                            </div>
                            <strong class="text-nowrap">@line.TotalPrice.ToString("N0") ₫</strong>
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-between mt-3 mb-2"><span class="text-secondary">Tạm tính</span><span>@Model.Quote.Subtotal.ToString("N0") ₫</span></div>
                <div class="d-flex justify-content-between mb-3"><span class="text-secondary">Khuyến mại</span><span class="text-success">−@Model.Quote.PromotionDiscount.ToString("N0") ₫</span></div>
                <hr />
                <div class="d-flex justify-content-between align-items-baseline"><span class="fw-semibold">Tổng thanh toán</span><strong class="h4 text-primary">@Model.Quote.Total.ToString("N0") ₫</strong></div>
                <p class="small text-secondary mt-3 mb-0">Chưa tích hợp thanh toán trực tuyến. Đơn sẽ ở trạng thái PENDING và giữ hàng sau khi lưu thành công.</p>
            </section>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
