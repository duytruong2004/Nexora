<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NEXORA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
    <header class="storefront-header">
        <nav class="navbar navbar-expand-xl navbar-dark nexora-navbar">
            <div class="container">
                <a class="navbar-brand nexora-wordmark" asp-controller="Home" asp-action="Index"><span class="nexora-brand-mark" aria-hidden="true">N</span><span>NEXORA</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Mở điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Catalog" asp-action="Index">Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Consultation" asp-action="Index">Tư vấn</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">Tài khoản</a></li>
                        }
                        @if (User.IsInRole("Sales"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="RoleLanding" asp-action="Sales">Bán hàng</a></li>
                        }
                        @if (User.IsInRole("Warehouse"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="RoleLanding" asp-action="Warehouse">Kho hàng</a></li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="RoleLanding" asp-action="Admin">Quản trị</a></li>
                        }
                    </ul>
                    <form class="d-flex me-lg-3 mb-3 mb-lg-0" asp-controller="Catalog" asp-action="Index" method="get" role="search">
                        <label class="visually-hidden" for="headerSearch">Tìm sản phẩm</label>
                        <input id="headerSearch" name="search" class="form-control form-control-sm" type="search" placeholder="Tìm sản phẩm" />
                        <button class="btn btn-outline-light btn-sm ms-2" type="submit">Tìm</button>
                    </form>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="navbar-text d-none d-md-inline">Đã đăng nhập</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button class="btn btn-outline-light btn-sm" type="submit">Đăng xuất</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Tạo tài khoản</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container storefront-main py-4 py-lg-5" id="main-content">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="alert alert-info" role="status">@statusMessage</div>
        }
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        @RenderBody()
    </main>

    <footer class="nexora-footer py-4 mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 small">
            <span>© @DateTime.UtcNow.Year NEXORA</span>
            <span>Nền tảng thương mại điện tử thiết bị công nghệ · <a asp-controller="Consultation" asp-action="Index">Tư vấn theo nhu cầu</a></span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
